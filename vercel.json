{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/recharge",
      "destination": "/index.html"
    },
    {
      "source": "/refresh",
      "destination": "/index.html"
    },
    {
      "source": "/claude-refresh",
      "destination": "/index.html"
    },
    {
      "source": "/batch",
      "destination": "/index.html"
    },
    {
      "source": "/api-docs",
      "destination": "/api-docs.html"
    },
    {
      "source": "/card-tool",
      "destination": "/card-tool.html"
    },
    {
      "source": "/tool",
      "destination": "/card-tool.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://987ai.vip; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; worker-src 'none'; media-src 'none'; manifest-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
